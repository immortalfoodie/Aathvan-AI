# Database connection string
# For PostgreSQL: postgresql://user:password@localhost:5432/lifesaver
# For SQLite (local dev): sqlite:///./lifesaver.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lifesaver

# JWT configuration
JWT_SECRET=change-me-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS (comma-separated origins allowed)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Anthropic API Key
ANTHROPIC_API_KEY=your-api-key-here

